{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "worklens-demo",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-26",
  "workers_dev": true,
  "assets": {
    "directory": "../frontend/dist/frontend/browser",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "containers": [
    {
      "class_name": "WorkLensDemoApi",
      "image": "../src/WorkLens.Api/Dockerfile",
      "image_build_context": "..",
      "max_instances": 1,
      "instance_type": "basic"
    }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "API", "class_name": "WorkLensDemoApi" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["WorkLensDemoApi"] }
  ],
  "observability": { "enabled": true }
}
