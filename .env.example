# Copy this file to .env and fill in real values before running either Docker mode.
# .env is gitignored — never commit real secrets.

# Required: SQL Server "sa" password. Must satisfy SQL Server's complexity policy
# (8+ chars, upper+lower+digit+symbol).
SQL_SA_PASSWORD=Change_Me_Strong_Passw0rd!

# How often the backend polls upstream job feeds (RemoteOK, Remotive, Greenhouse, Dice),
# in seconds. This is separate from the frontend's 5-10s UI refresh — the UI always
# polls the API's own cache, never upstream directly. 120s is a reasonable default;
# don't set this below ~60s to stay a good citizen of the free feeds.
FEED_REFRESH_INTERVAL_SECONDS=120

# Optional: one or more Greenhouse company board tokens to include in the feed, found
# in a company's public career page URL: boards.greenhouse.io/{board_token}.
# Add GREENHOUSE_BOARD_TOKEN_1, _2, etc. plus a matching line in docker-compose.yml
# under JobFeeds__Greenhouse__BoardTokens__N if you want more than one.
GREENHOUSE_BOARD_TOKEN_0=

# Expose the native OpenAPI document at /openapi/v1.json on the API. Set to false in
# production if you don't want it public.
SWAGGER_ENABLED=true

# Required for resume-to-job match scoring (the "Score matches vs. resume" button on
# the Feed page). Get a key at https://platform.openai.com/api-keys. Leave blank to
# disable match scoring entirely — the rest of the app works fine without it.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
