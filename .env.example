# Copy this file to .env and fill in real values before running either Docker mode.
# .env is gitignored — never commit real secrets.

SQL_SA_PASSWORD=Change_Me_Strong_Passw0rd!
FEED_REFRESH_INTERVAL_SECONDS=120
GREENHOUSE_BOARD_TOKEN_0=
SWAGGER_ENABLED=true

# Resume match scoring.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Microsoft Outlook / Graph integration.
# Create a Microsoft Entra app registration and add delegated permissions:
# User.Read, Mail.Read, offline_access, openid, profile.
# Add this redirect URI as a Web redirect URI:
# http://localhost:5080/api/outlook/callback
OUTLOOK_CLIENT_ID=
OUTLOOK_CLIENT_SECRET=
OUTLOOK_TENANT=common
OUTLOOK_REDIRECT_URI=http://localhost:5080/api/outlook/callback
OUTLOOK_FRONTEND_REDIRECT_URI=http://localhost:8080/communications
OUTLOOK_LOOKBACK_DAYS=90
